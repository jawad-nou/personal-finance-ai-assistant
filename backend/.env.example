PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=budget_app
JWT_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Beirut

# Gemini through Google's OpenAI-compatible Chat Completions endpoint.
# Create a key in Google AI Studio; keep it only in backend/.env.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Optional model pricing, in USD per 1,000 tokens. Leave blank to omit cost estimates.
AI_INPUT_COST_PER_1K_USD=
AI_OUTPUT_COST_PER_1K_USD=

# Optional. Traces include timing, token counts and tool names, never prompt text or finance values.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=Personal Finance Assistant
